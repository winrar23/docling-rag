# === Пути хранения на хосте ===
# Требование: расположение volumes выбирает пользователь.
# Любые абсолютные или относительные (от корня проекта) пути.

# Данные Postgres (единственное хранилище индекса — pgvector)
PGDATA_DIR=./volumes/pgdata
# Кеш моделей HuggingFace (~2.3 ГБ для deepvk/USER-bge-m3, качается при первом add/search)
HF_CACHE_DIR=./volumes/hf-cache
# Загрузки через UI (используется с этапа 4)
UPLOADS_DIR=./volumes/uploads
# Каталог с книгами для `cli add` (монтируется read-only в /books)
BOOKS_DIR=./books

# === Порты ===
API_PORT=8000
API_DEV_PORT=8001
POSTGRES_PORT=5432

# === Postgres (приложение использует с этапа 2) ===
POSTGRES_USER=docling
POSTGRES_PASSWORD=docling
POSTGRES_DB=docling_rag
